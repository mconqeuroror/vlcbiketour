# ─── Site ───────────────────────────────────────────────────────────────
# Canonical production origin (no trailing slash). Used for canonical URLs,
# hreflang, sitemap and structured data.
SITE_URL=https://biketourvlc.com

# ─── Booking mode ───────────────────────────────────────────────────────
# "request"  — booking-request flow (default; no payment, no live availability)
# "instant"  — Stripe Checkout instant booking (requires all Stripe keys below,
#              real pricing in src/config/tours.ts, and policies configured)
BOOKING_MODE=request

# ─── Database ───────────────────────────────────────────────────────────
# Postgres (Vercel/Neon in production). For local dev, paste the pooled
# connection string from `vercel env pull` or any local Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/biketourvlc

# ─── Operator notifications ─────────────────────────────────────────────
# HTTPS webhook that receives a JSON POST for each new booking request
# (e.g. a Make/Zapier/n8n endpoint, or your own server).
OPERATOR_NOTIFICATION_WEBHOOK_URL=
# Optional: SMTP fallback for operator notification email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
OPERATOR_NOTIFY_EMAIL=
BOOKING_FROM_EMAIL=bookings@biketourvlc.com

# ─── Stripe (instant mode only — TEST keys until go-live is approved) ───
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key is not needed: we redirect to Stripe-hosted Checkout.

# ─── Analytics / consent (optional) ─────────────────────────────────────
# Leave empty to keep all nonessential tracking fully disabled.
ANALYTICS_SCRIPT_URL=
