# ─── Site ───────────────────────────────────────────────────────────────
# Canonical production origin (no trailing slash). Used for canonical URLs,
# hreflang, sitemap and structured data.
SITE_URL=https://biketourvlc.com

# All reservations require a verified Stripe payment before submission.
# Guide/bike availability is confirmed by the operator after payment.

# ─── Database ───────────────────────────────────────────────────────────
# Postgres (Vercel/Neon in production). For local dev, paste the pooled
# connection string from `vercel env pull` or any local Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/biketourvlc

# ─── Resend transactional email ────────────────────────────────────────
# Verify your sender domain in Resend before enabling payments.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Example sender: BikeTourVLC <bookings@your-verified-domain>
# Real inbox receiving bookings/contact messages and customer replies.
OPERATOR_NOTIFY_EMAIL=

# ─── Stripe — use TEST keys for local verification ─────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Webhook: /api/stripe/webhook
# Events: checkout.session.completed, checkout.session.expired,
# checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
# charge.refunded. Local webhook forwarding uses Stripe CLI.
# Publishable key is not needed: we redirect to Stripe-hosted Checkout.

# ─── Analytics / consent (optional) ─────────────────────────────────────
# Leave empty to keep all nonessential tracking fully disabled.
ANALYTICS_SCRIPT_URL=
